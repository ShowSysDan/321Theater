# Caddyfile for the 3·2·1→Theater public gateway (VPS: cyclorama).
# Install to /etc/caddy/Caddyfile, then: systemctl reload caddy
#
# Caddy obtains and renews the Let's Encrypt certificate automatically —
# dpc.321.theater must already resolve to this VPS (129.121.114.249) and
# ports 80+443 must be open before the first start.

dpc.321.theater {
	encode gzip

	# Browsers that have seen this header will never try plain HTTP again.
	header Strict-Transport-Security "max-age=31536000"

	# Stay out of search engines, archives, and AI training sets. The header
	# rides on EVERY response (gate pages and proxied app alike); robots.txt
	# must be answered here, pre-auth — otherwise crawlers get a 302 to the
	# gate and treat the site as having no robots policy at all.
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noai, noimageai"
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: GPTBot
User-agent: ChatGPT-User
User-agent: OAI-SearchBot
User-agent: ClaudeBot
User-agent: Claude-User
User-agent: Claude-SearchBot
User-agent: anthropic-ai
User-agent: Google-Extended
User-agent: Applebot-Extended
User-agent: CCBot
User-agent: PerplexityBot
User-agent: Bytespider
User-agent: meta-externalagent
User-agent: *
Disallow: /
` 200
	}

	# The gateway's own UI and check endpoint — never proxied to the app.
	handle /__gate/* {
		reverse_proxy 127.0.0.1:8100
	}

	# Paths that must not be reachable from the internet at all:
	#  - /internal/*      the OTP API (defense in depth on top of its secret)
	#  - /register        self-registration undermines the "email must already
	#                     have an account" premise; register on the LAN instead
	#  - /confirm-email/* only used by the registration flow
	# MUST be a `handle` block. Caddy runs directives in a fixed order, not
	# file order, and `handle` comes before `respond`: the bare
	# `respond @blocked 404` this used to be never ran, because the
	# catch-all `handle` below claimed every request first (found in 3.5.0
	# with a live Caddy; these paths were reachable by anyone past the gate).
	# A `handle` with a named matcher sorts ahead of the catch-all one.
	@blocked path /internal/* /register /register/* /confirm-email/*
	handle @blocked {
		respond 404
	}

	# Everything else: ask the gateway whether this browser has passed the
	# email-code check, then proxy to the app over the WireGuard tunnel.
	handle {
		forward_auth 127.0.0.1:8100 {
			uri /__gate/check
			copy_headers X-Gate-Email
		}
		# IMPORTANT: do not override the Host header here. The app's CSRF
		# protection compares the browser's Origin against the Host it
		# receives; Caddy passes the client Host through by default and
		# that behavior is load-bearing.
		#
		# NOTE: install.sh GENERATES this block from GATE_APP_INTERNAL_URLS
		# in /etc/321gateway/gateway.env — edit the env file and re-run
		# `install.sh --rewrite-caddy` rather than editing here. With
		# multiple 321T servers listed, the block becomes:
		#
		#   reverse_proxy 10.201.2.101:5400 10.201.2.102:5400 {
		#       lb_policy first
		#       health_uri /internal/cluster/primary
		#       health_interval 5s
		#       health_timeout 3s
		#   }
		#
		# — each server's probe answers 200 only while it holds the primary
		# role (the app's own leader election), so every request goes to that
		# ONE server and Caddy follows failover within ~5 s. With no server
		# holding the role, Caddy has no healthy upstream and answers 503
		# (shown as the page below) rather than picking one anyway. There
		# are no retries (lb_try_duration is unset), so a request is never
		# replayed against a second server.
		reverse_proxy 10.201.2.101:5400
	}

	# Branded "gateway offline" page instead of a blank 502/503/504 whenever
	# Caddy can't complete a request itself: the tunnel is down, no 321T
	# server holds the primary role (no healthy upstream = 503), or the
	# gateway process is down (forward_auth fails). Caddy serves the page
	# from disk, so it works in every one of those cases. Only errors Caddy
	# raises land here: a 5xx the app itself sends is an ordinary response
	# and passes through untouched. App fetch()/XHR calls get JSON.
	handle_errors {
		@unreachable expression `{err.status_code} in [502, 503, 504]`
		handle @unreachable {
			header Cache-Control "no-store"
			header Retry-After "30"
			@api expression `{header.X-Requested-With} == "XMLHttpRequest" || {header.Accept}.contains("application/json")`
			handle @api {
				header Content-Type "application/json"
				respond `{"error":"unavailable"}` 503
			}
			handle {
				header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
				header X-Frame-Options "DENY"
				header X-Content-Type-Options "nosniff"
				header Referrer-Policy "same-origin"
				root * /opt/321gateway/offline
				rewrite * /unavailable.html
				templates
				file_server
			}
		}
	}
}
