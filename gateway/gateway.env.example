# 3·2·1→Theater gateway configuration — copy to /etc/321gateway/gateway.env
# (root:gateway, mode 640). All secrets live here and only here.

# Signing key for the gateway's own cookies. Independent of every other key.
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
GATE_SECRET_KEY=

# Shared secret for the internal OTP API. MUST equal GATEWAY_SHARED_SECRET
# in the app server's .env. Generate the same way (a different value!).
GATE_SHARED_SECRET=

# The 321T server(s), reached over the WireGuard tunnel.
# THIS LIST IS THE SINGLE SOURCE OF TRUTH for which installations exist:
# the gateway polls each one's /internal/cluster/primary probe and sends
# traffic to whichever holds the primary role, and install.sh generates
# the Caddy upstream list from this same line (re-run with --rewrite-caddy
# after changing it). Comma-separated, preference order.
GATE_APP_INTERNAL_URLS=http://10.201.2.101:5400
# (Legacy single-server form, honored when the list above is unset:)
#GATE_APP_INTERNAL_URL=http://10.201.2.101:5400

# How long a passed email-code check is trusted, per browser.
GATE_SESSION_HOURS=12

# Cookie name. The __Host- prefix locks it to this exact host over HTTPS.
GATE_COOKIE_NAME=__Host-321gate
