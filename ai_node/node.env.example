# 3·2·1→Theater AI node — /etc/321ai-node/node.env (see ai_node/README.md).
# install.sh writes this file once (with a fresh NODE_SECRET) and never
# overwrites it. Restart after a change: sudo systemctl restart 321ai-node

# Address:port to listen on (HTTPS). Keep the port above 1023.
NODE_LISTEN=0.0.0.0:11500

# Shared secret. Every app server's .env sets AI_NODE_SECRET to this exact value.
NODE_SECRET=

# TLS certificate + key. install.sh makes a self-signed pair; the app servers
# pin it by fingerprint (AI_NODE_CERT_SHA256), so no CA is needed.
NODE_CERT=/etc/321ai-node/node.crt
NODE_KEY=/etc/321ai-node/node.key

# The Ollama on THIS machine (loopback only — Ollama has no password).
NODE_OLLAMA_URL=http://127.0.0.1:11434

# Models the app may use, comma-separated (e.g. llama3.1:8b,llama3.2).
# Empty: chat with any installed model, "Pull model" refused.
# Set: chat and pull only these.
NODE_MODELS=

# REQUIRED: the 321Theater app servers allowed to connect (IPs or CIDRs,
# comma-separated). The node refuses to start while this is empty; "any"
# accepts every address (requests still need the secret) — not recommended.
NODE_ALLOW_IPS=

# Model calls at once (the cluster's Settings → AI "concurrent sessions" also
# limits this), how long a call may wait for a free slot, largest context.
NODE_MAX_CONCURRENT=2
NODE_QUEUE_S=600
NODE_MAX_CTX=32768
