# 3·2·1→Theater server configuration — copy to .env in the app directory.
# .env is gitignored and never committed; keep it chmod 600 (it holds the DB
# password). This is the ONE config file for an install (3.4.0+). systemd
# loads it via EnvironmentFile=, and CLI tools (init_db.py, install.sh) read
# it directly. Restart the service after editing:
#   sudo systemctl restart 321theater
#
# Format: KEY=value, one per line. No spaces around '='. Lines starting with
# # are comments. No inline comments and no $VAR expansion, so a value
# containing # or $ can go in as-is; wrap it in quotes only if it has
# leading/trailing spaces.
#
# Upgrading from db_config.ini? Anything missing here is still read from
# db_config.ini, so nothing breaks while you port. To see where each value
# comes from and get the lines to paste:
#   python3 app_config.py            # sources (secrets masked)
#   python3 app_config.py --export   # PG_*/S3_* lines still only in db_config.ini
# Once every value is here, db_config.ini can be deleted.

# ── Flask session signing key (install.sh generates this) ────────────────────
SECRET_KEY=

# ── PostgreSQL (required) ────────────────────────────────────────────────────
# PG_HOST may be a hostname/IP or a Unix-socket directory (/var/run/postgresql).
# First-time setup after filling these in: python3 init_db.py
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=321theater
PG_USER=showadvance
PG_PASSWORD=
# app schema = theater data; shared schema = users/sessions shared across apps
PG_APP_SCHEMA=theater321
PG_SHARED_SCHEMA=shared
# Idle connections each app worker keeps for reuse (default 4; 0 = no pool).
#PG_POOL_MAX_IDLE=4

# ── S3 / SeaweedFS file storage (optional) ───────────────────────────────────
# Used when Settings → System → Database → File Storage is set to
# "Server config (.env)" (the default). Several gateways can be listed,
# comma-separated, in failover order.
#S3_ENDPOINT=http://localhost:8333
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_BUCKET=321theater

# ── Test server (optional) ───────────────────────────────────────────────────
# TEST_MODE=1 marks this install as a TEST instance. It:
#   - never joins the cluster (no heartbeat, never leader, never the
#     gateway's primary), so it can't take over production's jobs, even if
#     it shares production's database;
#   - skips every leader-only background job: scheduled PDF emails,
#     field-change alerts, no-labor alerts, Prism auto-sync;
#   - emails ONLY users with the admin role (plus the allowlist below), with
#     the subject prefixed [TEST INSTANCE]; everyone else is suppressed and
#     shows as "not sent" in Settings → Email Log;
#   - still forwards syslog, with every line prefixed [TEST INSTANCE];
#   - shows a TEST INSTANCE badge in the sidebar and on the sign-in page.
# Local backups and the hourly DB housekeeping still run. Point the test
# server at its own S3 bucket: S3 file keys are id-based, so a copied
# database writing into production's bucket could overwrite its files.
#TEST_MODE=1
# Extra addresses (exact, comma-separated) that may receive test mail too.
#TEST_MODE_EMAIL_ALLOWLIST=someone@example.org

# ── HTTPS / VPS gateway (optional — see gateway/README.md) ───────────────────
# Mark the session cookie Secure (set when users reach the app over HTTPS).
#SESSION_COOKIE_SECURE=1
# Shared secret for the /internal/gateway/otp/* endpoints (same value as
# GATE_SHARED_SECRET on the VPS). Unset = endpoints answer 404.
#GATEWAY_SHARED_SECRET=
# Restrict those endpoints to these raw socket peer IPs (comma-separated).
#GATEWAY_PEER_IPS=10.201.4.9
# Honor X-Forwarded-For/-Proto only from these proxy IPs (comma-separated).
#TRUSTED_PROXY_IPS=10.201.4.9
