# LEGACY (deprecated in 3.4.0) — new installs put these in .env instead.
# See .env.example: PG_HOST, PG_PORT, PG_DBNAME, PG_USER, PG_PASSWORD,
# PG_APP_SCHEMA, PG_SHARED_SCHEMA, PG_POOL_MAX_IDLE and S3_ENDPOINT,
# S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET.
#
# An existing db_config.ini keeps working: any key missing from .env is still
# read from here (and logged once as CONFIG_LEGACY). To port:
#   python3 app_config.py --export >> .env    # then restart and check
#   python3 app_config.py                     # every source should read .env
# and delete db_config.ini. Path override: THEATER_DB_CONFIG.

[postgresql]
host           = localhost
port           = 5432
dbname         = 321theater
user           = showadvance
password       = yourpassword
app_schema     = theater321
shared_schema  = shared
# pool_max_idle  = 4

[seaweedfs]
endpoint       = http://localhost:8333
access_key     = your_access_key
secret_key     = your_secret_key
bucket         = 321theater
