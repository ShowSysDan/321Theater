# 3·2·1→Theater PostgreSQL connection credentials
# Copy this file to db_config.ini and fill in your values.
# db_config.ini is gitignored and never committed.
#
# The app runs on PostgreSQL only — this file is the ONLY place the database
# connection is configured (override the path with THEATER_DB_CONFIG).
# host may be a hostname/IP or a Unix-socket directory (e.g. /var/run/postgresql).
# Edit this file and restart the app to apply changes.
# First-time setup: python3 init_db.py  (creates schemas/tables + seeds defaults)
#
# Two schemas are used:
#   app_schema    – theater-specific data (shows, schedules, contacts, etc.)
#   shared_schema – user/auth data shared across apps (users, groups, sessions)

[postgresql]
host           = localhost
port           = 5432
dbname         = 321theater
user           = showadvance
password       = yourpassword
app_schema     = theater321
shared_schema  = shared
# Idle connections each app worker keeps for reuse (connection pool, 3.3.0).
# 0 = open a new connection every time (the pre-3.3.0 behavior).
# pool_max_idle  = 4

[seaweedfs]
endpoint       = http://localhost:8333
access_key     = your_access_key
secret_key     = your_secret_key
bucket         = 321theater
